# Copy to .env and fill in real values. This file contains placeholders only - nothing here works as a credential.
# Never commit .env (it is in .gitignore).

# --- Required -------------------------------------------------------------------------------
# PostgreSQL / Neon connection string. Neon: copy it from the console and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# API clients, comma-separated name:role:sha256-of-key. Roles: reporter (submit/read), reviewer (+ approve
# remediation), admin. Create entries with:  python -m scripts.make_api_key <name> <role>
# Clients send the plain key in the X-API-Key header; only its digest lives here.
API_KEYS=
# Legacy single key (becomes admin identity "default"). Prefer API_KEYS.
API_KEY=
# Four-eyes rule: the identity that submitted an incident may not approve its remediation.
ALLOW_SELF_APPROVAL=false
# Incident submissions per identity per minute (in-process; 0 disables).
RATE_LIMIT_PER_MINUTE=30
# --- Job queue --------------------------------------------------------------------------------
# Run a worker thread inside the API process (set false when running `python -m src.worker` separately).
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=1
# Claim lease; workers renew it every lease/3 while analysing, so it bounds how long a crashed worker's
# incident waits before it is re-queued.
JOB_LEASE_SECONDS=300
# Claims per incident before it fails as `interrupted`.
MAX_JOB_ATTEMPTS=2
# Claims allowed while transient provider errors (rate limit, timeout, outage) are retried with backoff.
MAX_TRANSIENT_RETRIES=3
# Comma-separated owner/repo list the service may analyse. Incidents for other repositories get 403.
ALLOWED_REPOSITORIES=your-org/your-repo
# Groq API key (https://console.groq.com). Without it every analysis ends as status "failed".
GROQ_API_KEY=

# --- LLM --------------------------------------------------------------------------------------
MODEL_NAME=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Lower this (e.g. 900) for models whose tier caps output tokens per minute below one reply.
LLM_MAX_OUTPUT_TOKENS=4096
# Optional USD prices per million tokens, used only for cost estimates in evaluation reports.
# Check current prices with your provider; leave 0 to report no cost.
LLM_COST_INPUT_PER_MTOK=0
LLM_COST_OUTPUT_PER_MTOK=0

# --- Workflow ---------------------------------------------------------------------------------
# Quality-gate threshold for the deterministic rubric score (0-1). Not a probability.
QUALITY_THRESHOLD=0.85
# Maximum LLM analysis attempts per incident (1-5).
MAX_ANALYSIS_ITERATIONS=3
# Model time per incident (seconds): once the attempts so far used it, no further attempt starts (30-3600)
MAX_INCIDENT_SECONDS=300
CODE_CONTEXT_RADIUS=50
# Calling application frames shown to the model (0 disables) and lines around each.
CALLER_CONTEXT_FRAMES=2
CALLER_CONTEXT_RADIUS=8
MAX_PATCH_CHANGED_LINES=40

# --- GitHub (optional) ------------------------------------------------------------------------
# Fine-grained token limited to ALLOWED_REPOSITORIES.
#   Analysis only:  Contents: Read
#   Remediation:    Contents: Read & write, Pull requests: Read & write
GITHUB_TOKEN=
# Opening pull requests is opt-in. PRs are never merged automatically.
ENABLE_GITHUB_REMEDIATION=false
GITHUB_PR_DRAFT=true
# true (default): an accepted fix waits in `awaiting_approval` until a human approves it via
# POST /incidents/{id}/remediation/decision. Missing approval is never treated as consent.
REQUIRE_REMEDIATION_APPROVAL=true
APPROVAL_TTL_HOURS=72

# --- Sandboxed test run (optional) ----------------------------------------------------------------
# true: before a patch is proposed, run the target repository's tests in a throwaway Docker container (no network,
# read-only root, capped memory/CPU/processes) with and without the patch, and show the result to the reviewer.
# Needs Docker on the host. With no network the image must already contain the repository's dependencies.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_COMMAND=python -m pytest -q -x -p no:cacheprovider
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_MB=512
SANDBOX_MAX_REPO_MB=50

# --- Sentry webhooks (optional) -----------------------------------------------------------------
# Client Secret of the Sentry internal integration; empty disables POST /integrations/sentry.
SENTRY_CLIENT_SECRET=
# Sentry project id -> allow-listed repository, comma-separated: 1234567:your-org/your-repo
SENTRY_PROJECT_REPOS=

# --- Alertmanager webhook (POST /integrations/alertmanager, reporter key as Bearer token) ---------
# Alert label that names the GitHub repository (owner/repo).
ALERTMANAGER_REPO_LABEL=repository

# --- Ask about this incident (grounded Q&A in the console and POST /incidents/{id}/ask) ---------
ASK_ENABLED=true
ASK_RATE_LIMIT_PER_MINUTE=10

# --- Reviewer notifications (optional) ----------------------------------------------------------
# https:// incoming-webhook URL (Slack / Mattermost). Empty disables notifications.
NOTIFY_WEBHOOK_URL=
NOTIFY_ON_STATUSES=awaiting_approval,failed
# Public URL of this service, used for console links in notifications.
PUBLIC_BASE_URL=

# --- Langfuse (optional) ----------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# false: long strings (prompts, source code, model output) are replaced by a length marker before upload.
LANGFUSE_CAPTURE_CONTENT=false

# --- Local development only -------------------------------------------------------------------
# true disables API-key checks. Never enable on a reachable host.
ALLOW_UNAUTHENTICATED=false
LOG_LEVEL=INFO
# Prometheus endpoint GET /metrics (aggregate counters only, no content).
METRICS_ENABLED=true
# Reviewer web UI at /console (uses the same API keys and rules as the API).
CONSOLE_ENABLED=true
